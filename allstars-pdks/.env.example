# PostgreSQL veritabanı bağlantı adresi (Neon, Supabase, Railway vb.)
DATABASE_URL="postgresql://kullanici:sifre@host/veritabani?sslmode=require"

# Sitenin yayındaki tam adresi (Kapı QR Afişi ve telefon eşleştirme linkleri için)
PUBLIC_URL="https://allstars-pdks.vercel.app"

# İlk kurulum ekranını (/api/setup) yetkisiz kişilerden korumak için gizli anahtar (isteğe bağlı ama önerilir)
SETUP_KEY=""

# Yönetici şifresi unutulduğunda sıfırlamak için kurtarma anahtarı (en az 12 karakter, isteğe bağlı)
ADMIN_RECOVERY_KEY=""

# Yerel çalışma portu (isteğe bağlı, varsayılan: 3000)
PORT=3000
