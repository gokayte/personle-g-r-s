{
  "version": 2,
  "regions": ["fra1"],
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/", "has": [{ "type": "query", "key": "k" }], "destination": "/p", "permanent": false },
    { "source": "/", "has": [{ "type": "query", "key": "pair" }], "destination": "/p", "permanent": false },
    { "source": "/index.html", "has": [{ "type": "query", "key": "k" }], "destination": "/p", "permanent": false },
    { "source": "/index.html", "has": [{ "type": "query", "key": "pair" }], "destination": "/p", "permanent": false },
    { "source": "/admin", "has": [{ "type": "query", "key": "k" }], "destination": "/p", "permanent": false },
    { "source": "/admin", "has": [{ "type": "query", "key": "pair" }], "destination": "/p", "permanent": false },
    { "source": "/admin.html", "has": [{ "type": "query", "key": "k" }], "destination": "/p", "permanent": false },
    { "source": "/admin.html", "has": [{ "type": "query", "key": "pair" }], "destination": "/p", "permanent": false },
    { "source": "/kiosk", "has": [{ "type": "query", "key": "k" }], "destination": "/p", "permanent": false },
    { "source": "/kiosk", "has": [{ "type": "query", "key": "pair" }], "destination": "/p", "permanent": false },
    { "source": "/kiosk.html", "has": [{ "type": "query", "key": "k" }], "destination": "/p", "permanent": false },
    { "source": "/kiosk.html", "has": [{ "type": "query", "key": "pair" }], "destination": "/p", "permanent": false },
    { "source": "/kurulum", "has": [{ "type": "query", "key": "k" }], "destination": "/p", "permanent": false },
    { "source": "/kurulum.html", "has": [{ "type": "query", "key": "k" }], "destination": "/p", "permanent": false },
    { "source": "/marka/kapi-afisi.html", "has": [{ "type": "query", "key": "k" }], "destination": "/p", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api?__p=$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    }
  ]
}
